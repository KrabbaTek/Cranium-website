
<h1>Hey, <%= @greeting %>!</h1>

<p>
  What are you trying to do?
</p>

<%= link_to 'Publish a new package', new_package_path %>
<br>
<%= link_to 'See your packages', user_packages_path %>

<br>
<br>
<%= link_to "Log out", logout_path, data: { turbo_method: :delete } %> <p>
  (go back to the homepage)
</p>

<br>
<br>
<button id="fun-fact">Get a fun fact</button>

<br>
<strong id="fun-fact-display">
</strong>

<script>
  document.addEventListener("turbo:load", () => {

    var funFactButton = document.getElementById("fun-fact")
    if (!funFactButton) {
        return
    }

    const getRandomItem = (funFacts) => {
        return funFacts[Math.floor(Math.random() * funFacts.length)]
    }

    var lastRandomItem = ""

    document.getElementById("fun-fact").addEventListener("click", () => {
        var funFacts = ["The Swedish parliament is called riksdag and it has 349 members in a single chamber.",
        "Sweden is so long that it’s possible for northern parts to have snow on the ground despite the south being in bloom.",
        "In Norway, the lake Hornindalsvatnet is the deepest lake in Europe.",
        "Located in Norway, Sognefjorden is the world’s second deepest fjord.",
        "Denmark is one of the happiest countries in the world according to the UN world happiness report.",
        "The Danish flag “Dannebrog” is the world’s oldest flag, being first acknowledged in 1219.",
        "Around 75% of Finland’s surface area is covered with forests, and Finland is home to the world’s largest archipelago.",
        "In Helsinki, 11 out of 12 lost wallets are returned to their owners."
        ]

        var randomItem = getRandomItem(funFacts)

        // prevent duplicates. Not that serious but it feels like the website is broken which I don't want.
        while (randomItem == lastRandomItem) {
            randomItem = getRandomItem(funFacts)
        }

        lastRandomItem = randomItem
        document.getElementById("fun-fact-display").innerHTML = randomItem
    })
  })

</script>
