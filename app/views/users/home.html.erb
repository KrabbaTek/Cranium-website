<br>
<br>
<button id="fun-fact">Get a fun fact</button>

<strong id="fun-fact-display">
</strong>

<script>
  document.getElementById("fun-fact").addEventListener("click", () => {
      var funFacts = [""]
      var randomItem = funFacts[Math.floor(Math.random() * funFacts.length)]

      document.getElementById("fun-fact-display").innerHTML = randomItem

      console.log("Random item:" + randomItem)
  })
</script>
