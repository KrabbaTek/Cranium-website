
<h1 id="title">
  Cranium
</h1>

<p>
  There's <%= link_to "more than one way", "/thesis" %> to <%= link_to "do packages", "/tutorial" %>.
</p>

<h2>
  Find a package below
</h2>

<%= form_with url: search_path, method: :get do |form| %>
  <%= form.text_field :name %>

  <%= form.submit "Search" %>
<% end %>

<p>
  Or, <%= link_to "explore", explore_packages_path %> all the packages
</p>

<h2>
  If you're here to upload a package, then log in or sign up below.
</h2>

<%= link_to "Log in", "/session/new" %>
<%= link_to "Sign up", signup_path %>
