<h1>
  Answer these questions to publish a package
</h1>

<%= form_with url: create_package_path do |form| %>
  <%= form.hidden_field :user_id, value: current_user.id %>

  <%= form.label :name, "What's this package called?" %> <br>
  <%= form.text_field :name %> <br>

  <br>
  <%= form.label :description, "Can you tell me a bit about this library?" %> <br>
  <%= form.text_area :description %> <br>

  <%#
  TODO: Add a field for the GitHub url
  %>
<% end %>