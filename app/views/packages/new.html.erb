<h1>
  Answer these questions to publish a package
</h1>

<%= link_to "Back", user_home_path %>
<br>

<%= form_with model: @package, url: create_package_path, multipart: true do |form| %>
  <%= form.hidden_field :user_id, value: current_user.id %>

  <%= form.label :name, "What's this package called?" %> <br>
  <%= form.text_field :name %> <br>

  <br>
  <%= form.label :description, "Can you tell me a bit about this library?" %> <br>
  <%= form.text_area :description %> <br>

  <br>
  <%= form.label :github_url, "Provide a link to this project's GitHub repository" %> <br>
  <%= form.text_field :github_url %> <br>

  <br>
  <%= form.label :tarball, "Upload a tarball of this package's source code" %>
  <button id="tarball-help" type="button">Don't know how to tarball?</button>  <br>
  <%= form.file_field :tarball, accept: ".tar.gz" %> <br>

  <br>
  <div id="tarball-help-text" hidden>
    <p>
      To tarball a file, `cd` into the directory it is in and then run this command: <br>
      `tar -czvf (your_file_name).tar.gz (your_file_name)`
    </p>
  </div>

  <br>
  <br>
  <%= form.submit "Create and publish" %>
<% end %>

<script>
  document.getElementById("tarball-help").addEventListener("click", () => {
    document.getElementById("tarball-help-text").hidden = !document.getElementById("tarball-help-text").hidden
  })
</script>
