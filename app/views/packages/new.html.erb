<h1>
  It looks like you want to create a package. That's great! Just answer these questions.
</h1>

<%= form_with url: create_package_path do |form| %>
  <%= form.hidden_field :user_id, value: current_user.id %>

  <%= form.label :name, "What's this package called?" %>
  <%= form.text_field :name %>

  <%= form.label :description, "Can you tell me a bit about this?" %>
  <%= form.text_area :description %>

  <%= %>

  <%= %>
<% end %>