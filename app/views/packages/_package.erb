<strong>
  <%= package.name %>
</strong>

<p class="description">
  <%= package.description %>
</p>

<p>
  <%= package.downloads_count %> downloads
</p>

<p>
  See the source code for this project <%= link_to "here", package.github_url %>
</p>

<%= link_to "Download the raw tarball", url_for(package.tarball) %>

<br>
<h3>Commands:</h3>
<div data-controller="commands">
  <button type="button" data-action="commands#toggle">Show commands</button>
  <div data-commands-target="panel" hidden>
    <p>install:</p>
    <pre>cranium get <%= package.name %></pre>
    <p>git clone:</p>
    <pre>cranium tear-apart <%= package.name %></pre>
    <p>delete (if you installed it)</p>
    <pre>cranium execute <%= package.name %></pre>
  </div>
</div>
<hr>